# Copy this file to .env and fill in real values before running.

# Port the server listens on
PORT=4000

# On Railway, set these paths on a mounted volume such as /data.
# Leave them unset locally to use the project's server folder.
DB_PATH=server/data.sqlite
UPLOADS_DIR=server/uploads

# Admin login (used only the first time the database is created —
# after that, change the password from inside the admin dashboard)
ADMIN_USERNAME=bisola
ADMIN_PASSWORD=change-this-password

# Long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
